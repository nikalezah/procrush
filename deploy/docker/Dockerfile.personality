# Thin image: build context must be
# backend/personality/build/bin/linuxX64/releaseExecutable (contains personality.kexe)
#
# Runtime is debian:bookworm-slim (has libcrypt + libz matching K/N glibc).
# CA bundle is copied from eclipse-temurin — no apt-get (hangs on Windows Docker).
FROM eclipse-temurin:25-jre AS certs
FROM debian:bookworm-slim

COPY --from=certs /etc/ssl/certs /etc/ssl/certs
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

COPY personality.kexe /personality

ENV WORKER_HEALTH_PORT=8091
EXPOSE 8091

CMD ["/personality"]
